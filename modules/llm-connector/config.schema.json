{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "LLM 供应商",
      "enum": ["openai", "anthropic", "litellm-proxy"],
      "default": "litellm-proxy"
    },
    "model": {
      "type": "string",
      "description": "默认模型",
      "default": "gpt-4o-mini"
    },
    "maxRetries": {
      "type": "number",
      "description": "最大重试次数",
      "default": 3
    },
    "timeoutMs": {
      "type": "number",
      "description": "请求超时（毫秒）",
      "default": 60000
    }
  },
  "required": ["provider"]
}