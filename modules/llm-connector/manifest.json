{
  "id": "llm-connector",
  "version": "0.1.0",
  "name": "LLM Connector",
  "description": "统一 LLM 调用抽象层，提供模型路由、重试与用量统计能力",
  "capabilities": ["llm-call", "llm-stream", "model-routing"],
  "dependencies": [],
  "permissions": [
    { "resource": "network", "action": "read" },
    { "resource": "llm", "action": "execute" }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "description": "LLM 供应商",
        "enum": ["openai", "anthropic", "litellm-proxy"],
        "default": "litellm-proxy"
      },
      "model": {
        "type": "string",
        "description": "默认模型",
        "default": "gpt-4o-mini"
      },
      "maxRetries": {
        "type": "number",
        "description": "最大重试次数",
        "default": 3
      },
      "timeoutMs": {
        "type": "number",
        "description": "请求超时（毫秒）",
        "default": 60000
      }
    },
    "required": ["provider"]
  },
  "degradationPolicy": {
    "whenDependencyUnavailable": "disable"
  }
}