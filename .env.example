# ===== LLM 服務 =====
OPENAI_API_KEY=sk-your-key-here
# LiteLLM 模型名稱（可換成任何 LiteLLM 支援的模型，如 claude-3-5-sonnet、gemini/gemini-pro）
EVOL_MODEL=gpt-4o
# 反思迴圈參數
EVOL_PASS_THRESHOLD=8
EVOL_MAX_ITERATIONS=3

# ===== 後端服務（Phase 3 使用） =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REDIS_URL=redis://localhost:6379/0

# ===== 文本化存檔（Task 8.6，選填） =====
# JSONL 存檔目錄，預設為 backend/data/archives
#EVOL_ARCHIVE_DIR=

# ===== 向量資料庫（Phase 2 使用） =====
CHROMA_HOST=localhost
CHROMA_PORT=8100