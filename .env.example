# ===== LLM 服務 =====
OPENAI_API_KEY=sk-your-key-here
# LiteLLM 模型名稱（可換成任何 LiteLLM 支援的模型，如 claude-3-5-sonnet、gemini/gemini-pro）
EVOL_MODEL=gpt-4o
# 反思迴圈參數
EVOL_PASS_THRESHOLD=8
EVOL_MAX_ITERATIONS=3

# ===== 後端服務（Phase 3 使用） =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REDIS_URL=redis://localhost:6379/0

# ===== 文本化存檔（Task 8.6，選填） =====
# JSONL 存檔目錄，預設為 backend/data/archives
#EVOL_ARCHIVE_DIR=

# ===== 向量資料庫（Phase 2 使用） =====
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ===== OPC UA 工業微服務（Phase 7） =====
# OPC UA 伺服器位址
OPC_SERVER_URL=opc.tcp://localhost:4840/freeopcua/server/
# OPC 微服務綁定
OPC_SERVICE_HOST=0.0.0.0
OPC_SERVICE_PORT=8001
# 寫入白名單（逗號分隔標籤名稱前綴，空白表示不限制）
#OPC_WRITE_WHITELIST=Temperature,Pressure,ValvePosition,MotorSpeed
# 啟用模擬 OPC 伺服器（開發測試用）
#OPC_SIM_ENABLED=true
#OPC_SIM_PORT=4840
# EvoLoop → OPC 服務的內部 URL
#OPC_SERVICE_URL=http://localhost:8001