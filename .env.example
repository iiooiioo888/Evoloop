# ===== LLM 服務 =====
OPENAI_API_KEY=sk-your-key-here
# 可選端點：DeepSeek / OpenRouter / Ollama / vLLM 相容等
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# LiteLLM 模型名稱（會被模型池 clamp；單一廠商時請填該廠商模型）
EVOL_MODEL=gpt-4o
# 反思迴圈參數
EVOL_PASS_THRESHOLD=8
EVOL_MAX_ITERATIONS=3
# EVOL_MIN_SCORE_IMPROVEMENT=0.5
# EVOL_CROSS_EVAL_MODEL=

# ===== 模型池運維 =====
# 背景定時爬取通用端點 /models（OpenRouter 等）
EVOL_LLM_OPS_ENABLED=true
EVOL_LLM_OPS_INTERVAL_SEC=300

# ===== 角色目錄 =====
# EVOL_ROLE_CATALOG_PATH=backend/data/role_catalog.json

# ===== LLM 快取 =====
# EVOL_LLM_CACHE_SIZE=512
# EVOL_LLM_CACHE_TTL=3600
# EVOL_SEMANTIC_CACHE=true
# EVOL_SEMANTIC_THRESHOLD=0.92

# ===== 後端服務 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REDIS_URL=redis://localhost:6379/0

# ===== 文本化存檔（選填） =====
# EVOL_ARCHIVE_DIR=

# ===== 向量資料庫 =====
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ===== 上下文截斷（選填） =====
# EVOL_MAX_CONTEXT_CHARS=6000
# EVOL_MAX_ANSWER_CHARS=4000
# EVOL_DECOMPOSE_CACHE_SIZE=64

# ===== OPC UA 工業微服務 =====
OPC_SERVER_URL=opc.tcp://localhost:4840/freeopcua/server/
OPC_SERVICE_HOST=0.0.0.0
OPC_SERVICE_PORT=8001
# OPC_WRITE_WHITELIST=Temperature,Pressure,ValvePosition,MotorSpeed
# OPC_SIM_ENABLED=true
# OPC_SIM_PORT=4840
# OPC_SERVICE_URL=http://localhost:8001
# OPC_STAGE_TIMEOUT=30
# OPC_ACT_HUMAN_CONFIRM=false
